---
const stats = [
  { value: "₹5,000+ Cr", label: "Completed Projects" },
  { value: "₹1,000 Cr", label: "Ongoing Projects" },
  { value: "21+ States", label: "Pan-India Presence" },
  { value: "Global Reach", label: "Offices in India, Japan, USA" },
];
---

<section id="about" class="relative min-h-screen bg-white overflow-hidden flex items-center">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full py-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      
      <!-- Left Content Section -->
      <div class="space-y-8">
        <!-- Section Header -->
        <div class="relative">
          <h2 class="mt-2 text-4xl md:text-5xl  font-extrabold text-gray-900 leading-tight tracking-tight">
  About Us
</h2>
<div class="w-28 h-1 mt-3 bg-green-700 rounded"></div>

        </div>
        
        <!-- Company Description -->
        <div class="space-y-6 text-gray-700">
          <p class="text-lg leading-relaxed">
            Since 2011, <span class="font-semibold text-gray-900">Abhyuday</span> has been at the forefront of Project Management Consultancy, delivering comprehensive end-to-end solutions for industrial and infrastructure development. We specialize in creating state-of-the-art Food Parks and industrial clusters that drive economic growth.
          </p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
            <!-- Vision Card -->
            <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-1 border-[#eea522]">
              <div class="flex items-center mb-3">
                <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center mr-3">
                  <img src="/vision.png" alt="">
                </div>
                <h3 class="text-lg font-bold text-gray-900">Our Vision</h3>
              </div>
              <p class="text-gray-600 text-sm">To become one of the Top 5 Engineering Turnkey Project Management & EPC Companies in India.</p>
            </div>
            
            <!-- Mission Card -->
            <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-1 border-green-700">
              <div class="flex items-center mb-3">
                <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center mr-3">
                  <img src="/mission.png" alt="">
                </div>
                <h3 class="text-lg font-bold text-gray-900">Our Mission</h3>
              </div>
              <p class="text-gray-600 text-sm">Promote Make in India and contribute to an Atmanirbhar Bharat through innovative project solutions.</p>
            </div>
          </div>
        </div>
        
        <!-- Stats Grid -->
        <div class="pt-6">
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            {stats.map((stat, index) => (
              <div class={`bg-white rounded-xl p-4 shadow-sm border-2 border-gray-100 transition-all duration-300 hover:shadow-md hover:border-green-700 ${
                index === 3 ? 'md:col-span-3 md:w-64 md:mx-auto' : ''
              }`}>
                <h3 class="text-xl font-bold text-gray-900">{stat.value}</h3>
                <p class="mt-1 text-xs text-gray-600 font-medium">{stat.label}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
      
      <!-- Right Image Section -->
      <div class="relative">
        <!-- Main Image Container -->
        <div class="relative rounded-2xl overflow-hidden shadow-2xl">
          <img 
            src="/hero4.JPG" 
            alt="Abhyuday Project Management" 
            class="w-full h-[400px] lg:h-[500px] object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
          
          <!-- Experience Badge -->
          <div class="absolute bottom-6 left-6 bg-white/90 backdrop-blur-sm rounded-xl px-4 py-3 shadow-lg">
            <div class="flex items-center">
              <div class="w-10 h-10 rounded-full bg-[#eea522] flex items-center justify-center mr-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500">Trusted Since</p>
                <p class="text-xl font-bold text-gray-900">2011</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Custom font application */
  #about * {
    font-family: 'Poppins', sans-serif;
  }
  
  /* Ensure full viewport height */
  #about {
    min-height: 100vh;
    height: 100vh;
  }
  
  /* Responsive adjustments for mobile */
  @media (max-width: 1024px) {
    #about {
      height: auto;
      min-height: 100vh;
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
  }
</style>
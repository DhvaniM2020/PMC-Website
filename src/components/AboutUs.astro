---
const stats = [
  { value: "₹4,000+ Cr", label: "Completed Projects" },
  { value: "₹1,000 Cr", label: "Ongoing Projects" },
  { value: "21+ States", label: "Pan-India Presence" },
  { value: "10+ Years", label: "MoFPI & Cluster Expertise" },
  { value: "Global Reach", label: "Offices in India, Japan, USA" },
];
---

<section id="about" class="min-h-[100vh] flex items-top py-10 bg-[#F2F5F4] sm:py-20 font-[Poppins,sans-serif]">
  <div class="px-8 mx-auto sm:px-10 lg:px-16">
        <div class="text-center mt-13">
      <h2 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
        Who We Are
      </h2>
      <div class="w-24 h-1 mt-4 mx-auto bg-yellow-500 rounded"></div>
      <p class="mt-6 max-w-4xl mx-auto text-lg text-gray-600">
        Abhyuday, established in 2011, is a leading Project Management Consultancy driving transformative projects in Food Processing,Textile, and Defence sectors. With a strong national and global presence, it continues to deliver impactful solutions with excellence and innovation.
      </p>
    </div>

        <div class="w-full max-w-4xl mx-auto mt-12 grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="rounded-xl shadow-md p-8 text-center border-2 border-gray-200 bg-white transition-all duration-300 hover:shadow-2xl">
        <div class="flex justify-center mb-4">
          <img src="/our mission.svg" alt="Mission Icon" class="w-12 h-12" />
        </div>
        <h3 class="text-xl font-bold text-gray-900">Our Mission</h3>
        <p class="mt-2 text-medium text-gray-600 text-center">
          To provide exceptional project management consulting services that deliver successful outcomes for infrastructure and development projects across diverse sectors.
        </p>
      </div>

            <div class="rounded-xl shadow-md p-8 text-center border-2 border-gray-200 bg-white transition-all duration-300 hover:shadow-2xl">
        <div class="flex justify-center mb-4">
          <img src="/our Vision.svg" alt="Vision Icon" class="w-12 h-12" />
        </div>
        <h3 class="text-xl font-bold text-gray-900">Our Vision</h3>
        <p class="mt-2 text-medium text-gray-600 text-center">
          To be the leading PMC firm recognized for excellence, innovation, and reliability in project delivery, contributing to national development and growth.
        </p>
      </div>
    </div>

        <div class="text-center mt-16 mb-8">
    </div>

        <div class="max-w-8xl w-full grid grid-cols-2 lg:grid-cols-5 gap-5 divide-x divide-gray-300">
      {
        stats.map((stat) => (
          <div class="text-center px-4">
            <h3 class="text-3xl font-bold text-[#287354]">{stat.value}</h3>
            <p class="mt-2 text-medium text-gray-600">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
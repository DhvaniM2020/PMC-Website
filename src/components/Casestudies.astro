---
interface Project {
  title: string;
  description: string;
  imageUrl: string;
  location: string;
  status: string;
  projectValue: string;
  timeframe: string;
  link: string;
}

const projects: Project[] = [
  {
    title: "Gujarat Agro Infrastructure Mega Food Park",
    description:
      "Facilities: Blast Freezer, Frozen Store, Cold Store, Warehouse, Multi-Processing, Packaging Line, Water Distribution, and CETP",
    imageUrl: "/image4.png", // Placeholder image
    location: "Gujarat",
    status: "Completed",
    projectValue: "₹450 Crores",
    timeframe: "36 Months",
    link: "#",
  },
  {
    title: "Paithan Food Park",
    description:
      "Modern food processing plant with advanced cold storage and packaging facilities.",
    imageUrl: "/Paithan Food Park.jpg", // Placeholder image
    location: "Punjab",
    status: "Completed",
    projectValue: "₹280 Crores",
    timeframe: "24 Months",
    link: "#",
  },
  {
    title: "EPICOS",
    description:
      "World-class IT infrastructure with modern office spaces and technology amenities.",
    imageUrl: "/epicos.png", // Placeholder image
    location: "Bangalore",
    status: "Ongoing",
    projectValue: "₹380 Crores",
    timeframe: "30 Months",
    link: "#",
  },
];
---

<section
  id="Casestudies"
  class="py-16 bg-white sm:py-24 font-[Poppins,sans-serif]"
>
  <div class="max-w-6xl px-4 mx-auto sm:px-6 lg:px-8">
        <div class="text-center mb-10">
      <h2 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
        Our Major Projects
      </h2>
      <div class="w-24 h-1 mx-auto mt-4 bg-yellow-500 rounded"></div>
    </div>

        <div
      id="project-cards-container"
      class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
    >
      {projects.map((project) => (
        <article
          class:list={[
            "project-card relative group bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200 transition-all duration-300 hover:shadow-2xl",
            { "project-completed": project.status === "Completed" },
            { "project-ongoing": project.status === "Ongoing" },
          ]}
        >
          <div class="relative overflow-hidden">
            <img
              src={project.imageUrl}
              alt={project.title}
              class="object-cover w-full h-56 transform transition duration-500 group-hover:scale-105"
            />
            <span
              class:list={[
                "absolute top-4 right-4 px-3 py-1 text-xs font-semibold rounded-full text-white",
                { "bg-green-600": project.status === "Completed" },
                { "bg-yellow-500": project.status === "Ongoing" },
              ]}
            >
              {project.status}
            </span>
          </div>

          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900">{project.title}</h3>
            <p class="mt-2 text-sm text-gray-600 line-clamp-3">
              {project.description}
            </p>

            <div class="mt-4 text-xs text-gray-500 space-y-1">
              <div class="flex items-center">
                <svg
                  class="w-4 h-4 mr-2"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                </svg>
                <span>{project.location}</span>
              </div>

              <div class="flex items-center">
                <svg
                  class="w-4 h-4 mr-2"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8c-2.485 0-4.5 2.015-4.5 4.5S9.515 17 12 17s4.5-2.015 4.5-4.5S14.485 8 12 8z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 1v2m0 18v2m9-9h-2M3 12H1m15.536 6.536l-1.414-1.414M7.879 7.879L6.465 6.465m12.728 0l-1.414 1.414M7.879 16.121l-1.414 1.414M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                <span>{project.projectValue}</span>
              </div>

              <div class="flex items-center">
                <svg
                  class="w-4 h-4 mr-2"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                <span>{project.timeframe}</span>
              </div>
            </div>

            <a
              href={project.link}
              class="block w-full py-3 mt-6 text-base font-bold text-center text-green-700 bg-white border-2 border-green-700 rounded-full transition-colors duration-300 hover:bg-green-700 hover:text-white"
            >
              View Details
            </a>
          </div>
        </article>
      ))}
    </div>

        <div class="mt-12 text-center">
      <a
        href="#"
        class="inline-block px-8 py-4 text-lg font-semibold text-white bg-green-700 rounded-full transition-colors duration-300 hover:bg-green-800"
      >
        View All Projects
      </a>
    </div>
  </div>
</section>
// Define the structure for each case study item for type safety
interface CaseStudy {
  title: string;
  description: string;
  imageUrl: string;
  imageAlt: string;
  link: string;
  isReversed?: boolean; // Optional property to reverse the layout
}


// Array of your service/case study data.
// This makes it easy to add, remove, or reorder items later.
const services: CaseStudy[] = [
  {
    title: "Gujarat Agro Infrastructure Mega Food Park @Surat - Gujarat",
    description: " Facilities: Blast Freezer, Frozen Store, Cold Store, Warehouse, Multi-Processing, Packaging Line, Water Distribution, and CETP ",
    imageUrl: "/image4.png",
    imageAlt: "A vibrant, modern farm with rows of crops under a clear sky.",
    link: "/services/mega-food-parks"
  },
  {
    title: `Paithan Mega Food Park @Aurangabad - Maharashtra `,
    description: ` Modern food processing plant with advanced cold storage and packaging facilities. `,
    imageUrl: "/Paithan Food Park.jpg",
    imageAlt: "A basket of fresh tomatoes, onions, and potatoes.",
    link: "/services/operation-greens",
    isReversed: true // This card will have the image on the left
  },
  {
    title: "GUJCOMASOL (Gujarat State Marketing Co-operative Federation Ltd.)",
    description: "Abhyuday provided complete turnkey advisory and end-to-end project management for GUJCOMASOL’s ₹300 crore Multi-Model Integrated Agro Logistics Park. The project encompassed planning and execution of integrated processing facilities for peanuts, bananas, ",
    imageUrl: "/epicos.png",
    imageAlt: "Interior of a large, modern cold storage warehouse.",
    link: "/services/cold-chain"
  },
  {

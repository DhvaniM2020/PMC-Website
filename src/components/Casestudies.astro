---

<section id="Casestudies" class="py-16 bg-gray-50 sm:py-24">
  <div class="max-w-6xl px-4 mx-auto sm:px-6 lg:px-8">
    <!-- Section Title -->
    <div class="text-center">
      <h2
        class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"
        style="font-family: 'Poppins'"
      >
        Our Projects
      </h2>
      <div class="w-24 h-1 mx-auto mt-4 bg-yellow-500 rounded"></div>
    </div>

    <!-- Cards Container -->
    <div class="mt-16 space-y-12 sm:space-y-16">
      {services.map((service) => (
        <article
          class:list={[
            "flex flex-col md:flex-row bg-white rounded-xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-2xl hover:-translate-y-1",
            { "md:flex-row-reverse": service.isReversed }
          ]}
        >
          <!-- Image Section -->
          <div class="md:w-1/2 w-full h-56 sm:h-72 md:h-auto">
            <img
              src={service.imageUrl}
              alt={service.imageAlt}
              class="object-cover w-full h-full"
            />
          </div>

          <!-- Content Section -->
          <div class="flex flex-col justify-center p-6 sm:p-8 md:p-12 md:w-1/2">
            <h3
              class="text-xl sm:text-2xl font-bold text-gray-900"
              style="font-family: 'Poppins'"
            >
              {service.title}
            </h3>
            <p
              class="mt-3 sm:mt-4 text-sm sm:text-base md:text-lg leading-relaxed text-gray-600"
              style="font-family: 'Poppins'"
            >
              {service.description}
            </p>
            <div class="mt-4 sm:mt-6">
              <a
                href={service.link}
                class="inline-block px-4 sm:px-6 py-2 sm:py-3 font-semibold text-gray-800 transition border border-gray-400 rounded-full hover:bg-green-500 hover:text-white hover:border-green-500"
                style="font-family: 'Poppins'"
              >
                Learn More
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

---
interface Testimonial {
  name: string;
  role: string;
  project: string;
  quote: string;
  stars: number;
  imageUrl: string;
}

const testimonials: Testimonial[] = [
  {
    name: "Priya Sharma",
    role: "Project Director",
    project: "₹280 Cr Food Processing Hub",
    quote:
      "Outstanding project management capabilities. They transformed our food processing vision into reality with minimal disruptions and maximum efficiency. Highly recommended.",
    stars: 5,
    imageUrl: "/vasant masala.png",
  },
  {
    name: "Rahul Patel",
    role: "CEO",
    project: "Agro Infrastructure Project",
    quote:
      "Abhyuday's team provided exceptional guidance from start to finish. Their attention to detail and proactive problem-solving ensured our project was a great success.",
    stars: 4,
    imageUrl: "/athos.png",
  },
  {
    name: "Anjali Gupta",
    role: "Operations Manager",
    project: "IT Park Development",
    quote:
      "Working with them was a seamless experience. They managed all aspects of the project, allowing us to focus on our core business. The result was a state-of-the-art facility delivered ahead of schedule.",
    stars: 5,
    imageUrl: "/bake buds.png",
  },
];
---

<div id="happy-clients" class="py-12 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-16">
    <div class="text-center mb-8">
      <h3
        class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-gray-800   tracking-wider"
      >
        Happy Clients
      </h3>
      <div class="w-24 h-1 mx-auto mt-4 bg-yellow-500 rounded"></div>
      <p class="mt-4 max-w-2xl mx-auto text-lg text-gray-600">
        Our success is measured by client satisfaction. Here's what our valued
        clients have to say about our project management services.
      </p>
    </div>

    <div
      class="relative bg-gray-50 rounded-3xl shadow-lg border border-gray-200 p-6 flex flex-col items-center max-w-5xl mx-auto"
    >
      <button
        id="prevBtn"
        class="absolute -left-4 top-1/2 -translate-y-1/2 p-3 bg-transparent border border-gray-300 text-gray-700 rounded-full shadow-md hover:bg-gray-100 transition-colors duration-300"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      <button
        id="nextBtn"
        class="absolute -right-4 top-1/2 -translate-y-1/2 p-3 bg-transparent border border-gray-300 text-gray-700 rounded-full shadow-md hover:bg-gray-100 transition-colors duration-300"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
      </button>

      <div
        id="slider"
        class="w-full flex overflow-x-hidden relative scroll-smooth snap-x"
      >
        {
          testimonials.map((testimonial) => (
            <div id="sliders" class="flex-shrink-0 sliders  w-full flex flex-col items-center text-center p-4 snap-center">
              <img
                src="/comma.png"
                alt="Quote Icon"
                class="h-16 w-16 text-gray-400 mb-4"
              />
              <div class="flex my-4">
                {[...Array(5)].map((_, i) => (
                  <span
                    class={`text-2xl ${i < testimonial.stars ? "text-yellow-400" : "text-gray-300"}`}
                  >
                    ★
                  </span>
                ))}
              </div>
              <p class="text-xl italic text-gray-600 max-w-xl mx-auto leading-relaxed">
                {testimonial.quote}
              </p>
              <div class="mt-6 pt-4 border-t border-gray-200 flex items-center space-x-4 justify-center">
                <img
                  class="w-12 h-12 rounded-full object-cover"
                  src={testimonial.imageUrl}
                  alt={testimonial.name}
                />
                <div>
                  <p class="font-bold text-lg text-gray-800">
                    {testimonial.name}
                  </p>
                  <p class="text-sm text-gray-500">{testimonial.role}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
      <div class="flex justify-center mt-3 space-x-2" id="pagination-dots">
      </div>
    </div>
  </div>
</div>

<script>
  const slider = document.getElementById("slider") as HTMLElement | null;
  const prevBtn = document.getElementById("prevBtn") as HTMLButtonElement | null;
  const nextBtn = document.getElementById("nextBtn") as HTMLButtonElement | null;
  const paginationDots = document.getElementById("pagination-dots") as HTMLElement | null;

  if (slider && prevBtn && nextBtn && paginationDots) {
    const slides = slider.querySelectorAll(".sliders") as NodeListOf<HTMLElement>;
    let currentIndex = 0;

    function updateSlider() {
      if (slides[currentIndex]) {
        slider?.scrollTo({
          left: slides[currentIndex].offsetLeft,
          behavior: "smooth",
        });
      }
      updateDots();
    }

    function updateDots() {
        if(paginationDots !== null)
      paginationDots.innerHTML = "";
      slides.forEach((_, i) => {
        const dot = document.createElement("div");
        dot.classList.add(
          "w-3",
          "h-3",
          "rounded-full",
          "mx-1",
          "transition-colors",
          "duration-300"
        );
        dot.classList.add(i === currentIndex ? "bg-gray-800" : "bg-gray-400");
        paginationDots?.appendChild(dot);
      });
    }

    prevBtn.addEventListener("click", () => {
      currentIndex = currentIndex > 0 ? currentIndex - 1 : slides.length - 1;
      updateSlider();
    });

    nextBtn.addEventListener("click", () => {
      currentIndex = currentIndex < slides.length - 1 ? currentIndex + 1 : 0;
      updateSlider();
    });

    slider.addEventListener("scroll", () => {
      const newIndex = Math.round(slider.scrollLeft / slider.offsetWidth);
      if (newIndex !== currentIndex) {
        currentIndex = newIndex;
        updateDots();
      }
    });

    updateSlider();
  }
</script>


          </p>
        </div>
        <div
          class="mt-auto pt-4 border-t border-gray-200 flex justify-between items-center text-sm text-gray-700 font-semibold"
        >
          <div>
            <p class="text-base text-gray-800 font-bold">62+ Projects</p>
            <p class="text-xs text-green-800">Completed</p>
          </div>
          <div>
            <p class="text-base text-green-800 font-bold">₹1100+ Crores</p>
            <p class="text-xs text-green-800">Project Value</p>
          </div>
        </div>
      </div>

      <div
        class="animated-card bg-white rounded-xl shadow-2xl border border-gray-200 p-6"
      >
        <div class="icon-container mb-4">
          <img src="/Tourism.svg" alt="Agri Icon" class="w-16 h-16" />
        </div>
        <div class="pt-4 pb-4 text-left">
          <h3 class="text-xl font-bold mb-2">Tourism</h3>
          <p class="text-sm text-gray-600">
            Resort developments, tourism infrastructure, hospitality projects,
            and recreational facility construction.
          </p>
        </div>
        <div
          class="mt-auto pt-4 border-t border-gray-200 flex justify-between items-center text-sm text-gray-700 font-semibold"
        >
          <div>
            <p class="text-base text-green-800 font-bold">28+ Projects</p>
            <p class="text-xs text-green-800">Completed</p>
          </div>
          <div>
            <p class="text-base text-green-800 font-bold">₹650+ Crores</p>
            <p class="text-xs text-green-800">Project Value</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
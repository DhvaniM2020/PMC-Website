<style>
/* 🌿 Core Services Section */
#CoreServices {
  background: #F2F5F4;
  font-family: 'Poppins', sans-serif;
  padding: 6rem 1rem;
}

/* Remove fixed heading size — Tailwind handles it */
#CoreServices h2 {
  font-weight: 700;
  text-align: center;
  color: #000000;
}

#CoreServices .underline {
  width: 6rem;
  height: 0.25rem;
  background-color: #facc15; /* yellow-500 */
  border-radius: 9999px;
  margin: 1rem auto 0 auto;
}

#CoreServices p.section-desc {
  text-align: center;
  color: #4b5563;
  max-width: 800px;
  margin: 1.5rem auto 4rem auto;
  font-size: 1.125rem;
  line-height: 1.7;
}

/* 🌿 Brick-like Grid Layout */
.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 2rem;
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
}

/* 🌿 Service Card Styling */
.service-item {
  background-color: #ffffff;
  border-radius: 1rem;
  padding: 2rem 1.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  position: relative;
  z-index: 1;
  --offsetY: 0px;
  transform: translateY(var(--offsetY));
}

/* 🌿 Brick stagger effect */

/* 🧱 For large desktops (≥1200px): normal 2-column brick */
@media (min-width: 1200px) {
  .service-item:nth-child(even) {
    --offsetY: 40px;
  }
}

/* 💻 For laptops (992px–1199px): perfect 3-column brick layout */
@media (min-width: 992px) and (max-width: 1199px) {
  .service-item:nth-child(3n + 2) {
    --offsetY: 40px;
  }

  .service-item:nth-child(3n + 1),
  .service-item:nth-child(3n + 3) {
    --offsetY: 0px;
  }
}

/* 📱 For tablets and below (<992px): no offset */
@media (max-width: 991px) {
  .service-item {
    --offsetY: 0px;
    transform: translateY(0);
  }
}

/* Hover */
.service-item:hover {
  transform: translateY(calc(var(--offsetY) - 10px));
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
}

/* 🌿 Replace dot with U-Pin */
.service-item::before {
  content: "";
  position: absolute;
  top: -15px;
  left: 50%;
  width: 30px;
  height: 30px;
  background-image: url('/upin.png');
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  transform: translateX(-50%) rotate(-3deg);
  z-index: 2;
}

/* Image/Icon inside card */
.service-item img {
  width: 60px;
  height: 60px;
  margin-bottom: 1rem;
}

/* Headings */
.service-item h3 {
  font-size: 1.1rem;
  font-weight: 600;
  color: #2b722e;
  margin-bottom: 0.5rem;
}

/* Description */
.service-item p {
  color: #4b5563;
  font-size: 0.95rem;
  line-height: 1.5;
}

/* Optional connector line */
.services-grid::before {
  content: "";
  position: absolute;
  top: 20px;
  left: 50%;
  width: 2px;
  height: 100%;
  background: linear-gradient(to bottom, #012717, transparent);
  transform: translateX(-50%);
  opacity: 0.4;
}

/* 🌿 Responsive tweaks */
@media (max-width: 1024px) {
  .service-item::before {
    top: -13px;
    width: 26px;
    height: 26px;
  }
}

@media (max-width: 768px) {
  .service-item:nth-child(even) {
    transform: none;
  }

  .services-grid::before {
    display: none;
  }

  .service-item::before {
    top: -13px;
    width: 24px;
    height: 24px;
  }
}
</style>


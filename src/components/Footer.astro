---
// This is the Astro component file for the footer section.
// It uses Tailwind CSS for styling.
---

<footer class="bg-green-800 text-gray-300 py-8 md:py-12 font-[Poppins,sans-serif]">
  <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">
    <!-- Logo & About Section -->
    <div class="md:col-span-1 text-center md:text-left">
      <div class="flex flex-col sm:flex-row items-center justify-center md:justify-start mb-4">
        <img
          src="/abhyuday logo.svg"
          alt="Abhyuday Bharat Logo"
          class="w-12 h-12 mb-3 sm:mb-0 sm:mr-3"
        />
        <div>
          <h3 class="text-lg sm:text-xl font-bold text-white">Abhyuday Bharat Projects Pvt. Ltd.</h3>
          <p class="text-xs">Project Management Company</p>
        </div>
      </div>
      <p class="text-sm mt-4 leading-relaxed">
        A leading Project Management Consulting Company having expertise in
        Industrial Cluster Development, Techno Economic Services and Turnkey
        Projects for Industries, Businesses and Government Agencies
      </p>

      <!-- Social Icons -->
      <div class="flex justify-center md:justify-start space-x-4 mt-6">
        <a
          href="https://www.facebook.com/abhyudaygroup"
          target="_blank"
          rel="noopener noreferrer"
          class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors duration-200"
          aria-label="Facebook"
        >
          <img src="/facebook1.png" alt="Facebook" class="w-6 h-6 filter invert brightness-200" />
        </a>
        <a
          href="https://x.com/group_abhyuday"
          target="_blank"
          rel="noopener noreferrer"
          class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors duration-200"
          aria-label="Twitter"
        >
          <img src="/x.png" alt="Twitter" class="w-6 h-6 filter invert brightness-200" />
        </a>
        <a
          href="https://www.linkedin.com/company/abhyudaygroup/?originalSubdomain=in"
          target="_blank"
          rel="noopener noreferrer"
          class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors duration-200"
          aria-label="LinkedIn"
        >
          <img src="/Linked In.png" alt="LinkedIn" class="w-6 h-6 filter invert brightness-200" />
        </a>
        <a
          href="https://www.instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors duration-200"
          aria-label="Instagram"
        >
          <img src="/Insta.png" alt="Instagram" class="w-6 h-6 filter invert brightness-200" />
        </a>
      </div>
    </div>

    <!-- Quick Links -->
    <div class="text-center md:text-left">
      <h3 class="text-lg font-bold text-white mb-4">Quick Links</h3>
      <ul class="space-y-3 text-sm">
        <li><a href="/#" class="hover:text-orange-300 transition-colors duration-200">Home</a></li>
        <li><a href="/#about" class="hover:text-orange-300 transition-colors duration-200">About Us</a></li>
        <li>
          <a href="/#CoreServices" class="hover:text-orange-300 transition-colors duration-200">Our Services</a>
        </li>
        <li>
          <a href="/#sectors" class="hover:text-orange-300 transition-colors duration-200">Sectors</a>
        </li>
        <li>
          <a href="/projects" class="hover:text-orange-300 transition-colors duration-200">Projects</a>
        </li>
        <li>
          <a href="/#join-us" class="hover:text-orange-300 transition-colors duration-200">Join Us</a>
        </li>
        <li>
          <a href="/vendor" class="hover:text-orange-300 transition-colors duration-200">Vendor Registration</a>
        </li>
        <li><a href="/#contact" class="hover:text-orange-300 transition-colors duration-200">Contact</a></li>
      </ul>
    </div>

    <!-- Contact Info -->
    <div class="text-center md:text-left">
      <h3 class="text-lg font-bold text-white mb-4">Contact Info</h3>
      <ul class="space-y-4 text-sm">
        <li class="flex flex-col sm:flex-row items-center md:items-start gap-2">
          <img
            src="/maps-and-flags 2.svg"
            alt="Location"
            class="w-5 h-5 text-gray-300"
          />
          <span class="text-center sm:text-left">
            1001 & 1020 Time Square Arcade,<br />Nr Bagban party plot,Thaltej
            Shilaj Road, Thaltej 380059, <br /> Ahmedabad, Gujarat, India
          </span>
        </li>
        <li class="flex flex-col sm:flex-row items-center md:items-start gap-2">
          <img
            src="/Phone.svg"
            alt="Phone"
            class="w-5 h-5 text-gray-300"
          />
          <div class="text-center sm:text-left">
            <a href="tel:+919904133088" class="block hover:text-orange-300 transition-colors duration-200"
              >+91 99041 33088</a
            >
          </div>
        </li>
        <li class="flex flex-col sm:flex-row items-center md:items-start gap-2">
          <img
            src="/Mail.svg"
            alt="Email"
            class="w-5 h-5 text-gray-300"
          />
          <div class="text-center sm:text-left">
            <a
              href="mailto:info@abhyuday.in"
              class="block hover:text-orange-300 transition-colors duration-200"
              >info@abhyuday.in</a
            >
          </div>
        </li>
        <li class="flex flex-col sm:flex-row items-center md:items-start gap-2">
          <img
            src="/Globe.svg"
            alt="Website"
            class="w-5 h-5 text-gray-300"
          />
          <a
            href="https://abhyuday.in/"
            target="_blank"
            class="hover:text-orange-300 transition-colors duration-200"
          >
            www.abhyuday.in
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="mt-8 md:mt-10 pt-3 text-center text-sm">
    <div
      class="flex flex-col sm:flex-row justify-center items-center max-w-7xl mx-auto px-4 border-t border-white/20 pt-3"
    >
      <p>© 2025 Abhyuday Bharat Projects. All rights reserved.</p>
    </div>
  </div>
</footer>
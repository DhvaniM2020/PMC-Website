---
// src/components/HeroSection.astro
export interface Props {
  images?: string[];
}

const defaultImages = [
   "/hero1.JPG",
   "/hero2.jpg",
   "/hero3.jpg",
  //  "/IT Sector.png",
  //  "/Agri_Food.png",
  // "/DPR.jpg",
];

const { images = defaultImages } = Astro.props;
---

<section class="relative flex overflow-hidden 
  h-[90vh] sm:h-[92vh] lg:h-[100vh] 
  font-[Poppins,sans-serif]">

  <!-- Background Images -->
  <div class="absolute inset-0 z-[-1]">
    {images.map((src, index) => (
      <img
        src={src}
        alt={`Background slide ${index + 1}`}
        class:list={[
          "bg-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-500 ease-in-out",
          index === 0 ? "opacity-100" : "opacity-0",
        ]}
      />
    ))}
    <!-- The new color overlay -->
    <div class="absolute inset-0 bg-black/50"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative flex justify-center items-center z-10 w-full h-full px-4 sm:px-6">
    <div class="max-w-xl sm:max-w-2xl text-center">
      <h1 class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-gray-200 leading-tight">
        Shaping the future of&nbsp;
        <!-- 👇 span height = li height -->
        <span class="inline-block h-[2.5rem] sm:h-[3rem] md:h-[4rem] lg:h-[5rem] text-[#eea522] overflow-hidden relative">
          <ul class="vertical-slider">
            <li>Infrastructure</li>
            <li>Industry</li>
            <li>Sustainability</li>
            <li>Development</li>
            <li aria-hidden="true">Infrastructure</li>
          </ul>
        </span>
      </h1>

      <p class="mt-4 sm:mt-6 text-gray-200 text-base sm:text-lg">
        Turnkey Project Management & EPC Consultancy for Multi-sector Industrial Development.
      </p>

      <div class="mt-10 flex justify-center">
        {/* Centered Button */}
        <button
          id="projects-button"
          class="
            flex justify-center gap-2 items-center 
            shadow-lg 
            bg-white text-gray-800 font-semibold 
            relative overflow-hidden 
            px-6 py-3 border-2 border-gray-300 
            rounded-full 
            transition-all duration-500 
            hover:text-white
            group
            text-base
            cursor-pointer
          "
        >
          <span class="relative z-10 transition-colors duration-300">
            Explore Our Projects
          </span>
          <div
            class="
              relative z-10
              w-8 h-8 
              flex items-center justify-center
              rounded-full border-2 border-gray-800
              group-hover:border-white
              group-hover:bg-white
              group-hover:rotate-90
              transition-all duration-300
              rotate-45
            "
          >
            <svg
              class="w-4 h-4"
              viewBox="0 0 16 19"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M7 18C7 18.5523 7.44772 19 8 19C8.55228 19 9 18.5523 9 18H7ZM8.70711 0.292893C8.31658 -0.0976311 7.68342 -0.0976311 7.29289 0.292893L0.928932 6.65685C0.538408 7.04738 0.538408 7.68054 0.928932 8.07107C1.31946 8.46159 1.95262 8.46159 2.34315 8.07107L8 2.41421L13.6569 8.07107C14.0474 8.46159 14.6805 8.46159 15.0711 8.07107C15.4616 7.68054 15.4616 7.04738 15.0711 6.65685L8.70711 0.292893ZM9 18L9 1H7L7 18H9Z"
                class="
                  fill-gray-800 
                  group-hover:fill-green-800 
                  transition-colors duration-300
                "
              />
            </svg>
          </div>
          
          {/* Hover background */}
          <div
            class="
              absolute inset-0 
              bg-green-800 
              transform scale-x-0 
              group-hover:scale-x-100 
              transition-transform duration-500 
              origin-left
              rounded-full
            "
          />
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const slides = document.querySelectorAll(".bg-slide");
  if (slides.length > 1) {
    let currentIndex = 0;
    setInterval(() => {
      slides[currentIndex].classList.remove("opacity-100");
      slides[currentIndex].classList.add("opacity-0");
      currentIndex = (currentIndex + 1) % slides.length;
      slides[currentIndex].classList.remove("opacity-0");
      slides[currentIndex].classList.add("opacity-100");
    }, 5000);
  }

  // Redirect to projects page when button is clicked
  document.getElementById('projects-button')?.addEventListener('click', () => {
    window.location.href = '/projects';
  });
</script>

<style is:global>
.vertical-slider {
  display: flex;
  flex-direction: column;
  animation: slideWords 8s ease-in-out infinite;
}

.vertical-slider li {
  height: 2.5rem; /* mobile default */
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Tablet */
@media (min-width: 640px) { 
  .vertical-slider li { height: 3rem; }
}
/* Medium */
@media (min-width: 768px) { 
  .vertical-slider li { height: 4rem; }
}
/* Large */
@media (min-width: 1024px) { 
  .vertical-slider li { height: 5rem; }
}

/* 👇 Sync animation exactly with li height */
@keyframes slideWords {
  0%, 20%   { transform: translateY(0); }
  25%, 45%  { transform: translateY(-2.5rem); }
  50%, 70%  { transform: translateY(-5rem); }
  75%, 95%  { transform: translateY(-7.5rem); }
  100%      { transform: translateY(-10rem); }
}

@media (min-width: 640px) {
  @keyframes slideWords {
    0%, 20%   { transform: translateY(0); }
    25%, 45%  { transform: translateY(-3rem); }
    50%, 70%  { transform: translateY(-6rem); }
    75%, 95%  { transform: translateY(-9rem); }
    100%      { transform: translateY(-12rem); }
  }
}

@media (min-width: 768px) {
  @keyframes slideWords {
    0%, 20%   { transform: translateY(0); }
    25%, 45%  { transform: translateY(-4rem); }
    50%, 70%  { transform: translateY(-8rem); }
    75%, 95%  { transform: translateY(-12rem); }
    100%      { transform: translateY(-16rem); }
  }
}

@media (min-width: 1024px) {
  @keyframes slideWords {
    0%, 20%   { transform: translateY(0); }
    25%, 45%  { transform: translateY(-5rem); }
    50%, 70%  { transform: translateY(-10rem); }
    75%, 95%  { transform: translateY(-15rem); }
    100%      { transform: translateY(-20rem); }
  }
}
</style>
---
// src/components/JoinUs.astro
---

<section id="join-us" class="py-10 bg-[#F2F5F4] sm:py-20 font-[Poppins,sans-serif]">
  <div class="px-8 mx-auto sm:px-10 lg:px-16 max-w-7xl">
    
    <div class="text-center">
      <h2 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
        Join Us & Invest in Growth
      </h2>
      <div class="w-24 h-1 mt-4 mx-auto bg-yellow-500 rounded"></div>
      <p class="mt-6 max-w-4xl mx-auto text-lg text-gray-600">
        We invite investors, landowners, and partners to collaborate with us. Leverage lucrative government schemes and our project management expertise to build the future of India's food processing sector.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      
      <div class="space-y-4">
        <h3 class="text-2xl font-bold text-gray-800 mb-6">Financial Assistance for Food Projects</h3>
        
        <div class="border border-gray-200 rounded-lg bg-white shadow-sm">
          <button class="accordion-toggle flex justify-between items-center w-full p-5 font-semibold text-left">
            <span>Central Government Schemes (MoFPI)</span>
            <svg class="accordion-icon w-6 h-6 shrink-0 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div class="accordion-content hidden p-5 border-t border-gray-200 text-gray-600">
            <ul class="list-disc list-inside space-y-2">
              <li><strong>CEFPPC:</strong> Max grant of <strong>₹5.00 Cr</strong> (35%/50%).</li>
              <li><strong>APC:</strong> Max grant of <strong>₹10.00 Cr</strong> (Min 10 Acres land).</li>
              <li><strong>Cold Chain:</strong> Max grant of <strong>₹10.00 Cr</strong> (35%/50%).</li>
              <li><strong>Operation Greens (TOP):</strong> Up to <strong>₹15.00 Cr</strong> for Integrated VCD.</li>
            </ul>
          </div>
        </div>

        <div class="border border-gray-200 rounded-lg bg-white shadow-sm">
          <button class="accordion-toggle flex justify-between items-center w-full p-5 font-semibold text-left">
            <span>State Government Subsidies</span>
             <svg class="accordion-icon w-6 h-6 shrink-0 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div class="accordion-content hidden p-5 border-t border-gray-200 text-gray-600">
            <ul class="list-disc list-inside space-y-2">
              <li><strong>Capital Investment Subsidy:</strong> Max <strong>₹50.00 to ₹500.00 Lacs</strong>.</li>
              <li><strong>Back Ended Interest Subsidy:</strong> Max <strong>₹150.00 to ₹400.00 Lacs</strong>.</li>
            </ul>
          </div>
        </div>

        <div class="border border-gray-200 rounded-lg bg-white shadow-sm">
          <button class="accordion-toggle flex justify-between items-center w-full p-5 font-semibold text-left">
            <span>Micro Project Examples</span>
             <svg class="accordion-icon w-6 h-6 shrink-0 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div class="accordion-content hidden p-5 border-t border-gray-200 text-gray-600">
            <p class="mb-3">Showcasing our expertise from <strong>116 Micro Food Processing Projects</strong>:</p>
            <ul class="list-disc list-inside space-y-2">
              <li><strong>Honey Processing Plant:</strong> Project value of ₹200.00 Lacs.</li>
              <li><strong>Tomato Sauce & Ketchup:</strong> Project value of ₹15.00 Lacs.</li>
              <li><strong>Spice Oleoresins (EOU):</strong> Project value of ₹170.00 Lacs.</li>
            </ul>
          </div>
        </div>
      </div>
      
      <div class="space-y-8">
        <div class="p-8 bg-white rounded-lg shadow-lg border-l-4 border-green-500">
            <div class="flex items-center gap-4">
                <div class="text-green-500"><svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg></div>
                <h3 class="text-2xl font-bold text-gray-800">For Investors</h3>
            </div>
          <p class="mt-4 text-gray-600">
            Capitalize on the high-growth food processing sector. We identify viable projects, secure government grants, and manage the entire project lifecycle to ensure maximum ROI for your investment.
          </p>
        </div>

        <div class="p-8 bg-white rounded-lg shadow-lg border-l-4 border-blue-500">
           <div class="flex items-center gap-4">
                <div class="text-blue-500"><svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg></div>
                <h3 class="text-2xl font-bold text-gray-800">For Land Owners</h3>
            </div>
          <p class="mt-4 text-gray-600">
            Transform your land into a revenue-generating asset. Partner with us to develop food parks or processing clusters. We handle the planning, approvals, and execution, creating lasting value for your property.
          </p>
        </div>
        <a href="/vendor" class="inline-block w-full text-center bg-yellow-500 text-gray-900 font-bold py-4 px-8 rounded-lg text-lg hover:bg-yellow-600 transition duration-300">
          Partner With Us
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const accordions = document.querySelectorAll('.accordion-toggle');

    accordions.forEach(button => {
      button.addEventListener('click', () => {
        const content = button.nextElementSibling;
        const icon = button.querySelector('.accordion-icon');

        content.classList.toggle('hidden');
        icon.classList.toggle('rotate-180');
      });
    });
  });
</script>
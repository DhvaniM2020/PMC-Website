--- /* Navbar.astro */ ---
<!-- MOBILE + TABLET NAVBAR (fixed floating menu, does NOT push content) -->
<header
  id="navbar-mobile"
  class="lg:hidden sticky top-0 z-50 bg-white shadow transition-all duration-300"
>
  <div class="max-w-8xl mx-auto px-6 py-3 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center space-x-2">
      <img
        src="/Abhyuday-New-Logo.jpg"
        alt="Abhyuday Logo"
        class="rounded-full h-10 w-auto transition-transform duration-300 hover:scale-110"
      />
      <span class="title font-semibold text-green-800" style="font-family:'Poppins';">
  ABHYUDAY BHARAT PROJECTS
</span>

    </a>

    <!-- Hamburger -->
    <button id="mobile-menu-btn" class="text-gray-900 focus:outline-none">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-7 w-7"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16m-7 6h7"
        />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden absolute top-full left-0 w-full bg-white shadow-lg py-2 text-base z-50"
  >
    <a href="/#" class="mobile-link block px-4 py-2 text-gray-700 hover:bg-gray-100">Home</a>
    <a href="/#about" class="mobile-link block px-4 py-2 text-gray-700 hover:bg-gray-100"
      >About Us</a
    >
    <a href="/#CoreServices" class="mobile-link block px-4 py-2 text-gray-700 hover:bg-gray-100"
      >Services</a
    >
    <a href="/#sectors" class="mobile-link block px-4 py-2 text-gray-700 hover:bg-gray-100"
      >Sectors</a
    >
    <a href="/projects" class="mobile-link block px-4 py-2 text-gray-700 hover:bg-gray-100"
      >Projects</a
    >
    <a href="/#join-us" class="mobile-link block px-4 py-2 text-gray-700 hover:bg-gray-100"
      >Join Us</a
    >
    <a href="/vendor" class="mobile-link block px-4 py-2 text-gray-700 hover:bg-gray-100"
      >Vendor Registration</a
    >
    <a href="/#contact" class="mobile-link block px-4 py-2 text-gray-700 hover:bg-gray-100">
  Contact Us
</a>

  </div>
</header>

<!-- DESKTOP FLOATING NAVBAR -->
<header
  id="navbar-desktop"
  class="hidden lg:flex fixed top-4 left-1/2 -translate-x-1/2 z-50
         bg-white shadow-lg rounded-full
         px-6 xl:px-10 py-3 xl:py-4
         w-[92%] xl:w-[85%]
         transition-all duration-300"
>
  <div class="flex items-center justify-between w-full">
    <!-- Logo -->
    <a href="/" class="flex items-center space-x-2 xl:space-x-3">
      <img
        src="/Abhyuday-New-Logo.jpg"
        alt="Abhyuday Logo"
        class="rounded-full h-10 xl:h-12 w-auto transition-transform duration-300 hover:scale-110"
      />
      <span
        class="text-base lg:text-lg xl:text-xl font-semibold text-green-800 tracking-tight"
        style="font-family:'Poppins'; line-height:1;"
      >
        ABHYUDAY BHARAT PROJECTS
      </span>
    </a>

    <!-- Center Links -->
    <nav
      class="flex items-center
             space-x-3 lg:space-x-4 xl:space-x-6
              text-gray-700
             text-sm xl:text-base"
    >
      <a href="/#" class="nav-link hover:text-green-800 relative">Home</a>
      <a href="/#about" class="nav-link hover:text-green-800 relative">About Us</a>
      <a href="/#CoreServices" class="nav-link hover:text-green-800 relative">Services</a>
      <a href="/#sectors" class="nav-link hover:text-green-800 relative">Sectors</a>
      <a href="/projects" class="nav-link hover:text-green-800 relative">Projects</a>
      <a href="/#join-us" class="nav-link hover:text-green-800 relative">Join Us</a>
      <a href="/vendor" class="nav-link hover:text-green-800 relative">Vendor Registration</a>
    </nav>

    <!-- Contact Button -->
    <a
      href="/#contact"
      class="bg-green-800 text-white
             text-sm xl:text-base
             py-2 px-4 xl:px-6
             rounded-full border border-green-800
             transition-all duration-300
             hover:bg-white hover:text-green-800 hover:shadow-lg"
    >
      CONTACT US
    </a>
  </div>
</header>

<script>
  const mobileNav = document.getElementById("navbar-mobile");
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  // Toggle dropdown without pushing content (with null checks)
  if (btn && menu) {
    btn.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });
  }

  // Auto close menu when link clicked
  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      if (menu) {
        menu.classList.add("hidden");
      }
    });
  });

  // Mobile scroll style
  window.addEventListener("scroll", () => {
    if (window.innerWidth < 1024 && mobileNav) {
      if (window.scrollY > 50) {
        mobileNav.classList.add("bg-white/70", "backdrop-blur-md");
      } else {
        mobileNav.classList.remove("bg-white/70", "backdrop-blur-md");
      }
    }
  });
</script>

<style>
  .nav-link::after {
    content: "";
    position: absolute;
    width: 100%;
    height: 2px;
    bottom: -3px;
    left: 0;
    background-color: #eea522;
    transform: scaleX(0);
    transition: transform 0.3s ease-in-out;
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }



/* COMPACT MODE FOR 1024px (lg breakpoint) */
@media (max-width: 1280px) and (min-width: 1024px) {

  #navbar-desktop {
    padding-left: 12px !important;
    padding-right: 12px !important;
  }

  #navbar-desktop img {
    height: 42px !important;  /* smaller logo */
  }

  #navbar-desktop .title {
    font-size: 0.9rem !important;   /* smaller title text */
    max-width: 160px;               /* restrict width */
    line-height: 1.1;
  }

  #navbar-desktop nav a {
    font-size: 0.78rem !important;  /* smaller link text */
    margin-left: 6px !important;
    margin-right: 6px !important;
  }

  #navbar-desktop .contact-btn {
    padding: 6px 14px !important;  /* smaller button */
    font-size: 0.8rem !important;
    white-space: nowrap;
  }
}



/* EXPANDED MODE FOR LARGE DESKTOPS (xl and above) */
@media (min-width: 1450px) {

  #navbar-desktop {
    padding-left: 50px !important;
    padding-right: 50px !important;
  }

  #navbar-desktop .title {
    font-size: 1.25rem !important;
  }

  #navbar-desktop nav a {
    font-size: 1.2rem !important;
    margin-left: 20px !important;
    margin-right: 20px !important;
  }

  #navbar-desktop img {
    height: 52px !important;
  }

  #navbar-desktop .contact-btn,
  #navbar-desktop a[href="#contact"] {
    padding: 10px 26px !important;
    font-size: 1rem !important;
  }
}



/* FIX FOR 1366 × 768 LAPTOP SCREENS */
@media (min-width: 1280px) and (max-width: 1400px) {

  /* Desktop navbar wrapper adjustments */
  #navbar-desktop {
    padding-left: 20px !important;
    padding-right: 20px !important;
    padding-top: 10px !important;
    padding-bottom: 10px !important;
  }

  /* Logo */
  #navbar-desktop img {
    height: 40px !important; /* smaller logo */
  }

  /* Title text */
  #navbar-desktop span {
    font-size: 0.95rem !important;
    max-width: 180px !important; /* prevent wrapping */
    white-space: nowrap;
  }

  /* Navigation links */
  #navbar-desktop nav a {
    font-size: 0.9rem !important;
    margin-left: 10px !important;
    margin-right: 10px !important;
    white-space: nowrap !important; /* force single line */
  }

  /* Contact button */
  #navbar-desktop a[href="/#contact"] {
    padding: 6px 14px !important;
    font-size: 0.9rem !important;
    white-space: nowrap !important;
  }
}


</style>

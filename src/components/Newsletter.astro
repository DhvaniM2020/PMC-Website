---

<section id="contact" class="bg-[#F2F5F4] py-30 ">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-12 mt-12">
      <h2 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl" style="font-family: 'Poppins'">
        Contact Us
      </h2>
      <div class="w-24 h-1 mx-auto mt-4 bg-green-700 rounded"></div>
    </div>

    <div class="flex flex-col md:flex-row gap-8">
      <div class="bg-gray-50 p-8 rounded-lg shadow-md flex-1">
        <h3 class="text-2xl font-bold tracking-tight text-gray-900 mb-6">Contact Form</h3>
        <div class="w-16 h-1 mt-2 bg-orange-500 rounded"></div>
        <form id="contactForm" class="mt-8">
          <div class="flex flex-col sm:flex-row gap-4 mb-4">
            <div class="w-full">
              <label for="first-name" class="block text-gray-700 font-medium mb-1">First Name <span class="text-orange-500">*</span></label>
              <input
                type="text"
                id="first-name"
                name="firstName"
                placeholder="First Name"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-800 transition"
              />
            </div>
            <div class="w-full">
              <label for="last-name" class="block text-gray-700 font-medium mb-1">Last Name <span class="text-orange-500">*</span></label>
              <input
                type="text"
                id="last-name"
                name="lastName"
                placeholder="Last Name"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-800 transition"
              />
            </div>
          </div>
          <div class="flex flex-col sm:flex-row gap-4 mb-4">
            <div class="w-full">
              <label for="email" class="block text-gray-700 font-medium mb-1">Email Address <span class="text-orange-500">*</span></label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="Email Address"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-800 transition"
              />
            </div>
            <div class="w-full">
              <label for="phone" class="block text-gray-700 font-medium mb-1">Phone Number <span class="text-orange-500">*</span></label>
              <div class="flex">
                <select name="countryCode" class="border border-gray-300 rounded-l-lg bg-white px-2 focus:outline-none">
                  <option value="+91">+91</option>
                  <option value="+1">+1</option>
                  <option value="+44">+81</option>
                </select>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="9876543210"
                  required
                  class="w-full px-4 py-3 border-t border-r border-b border-gray-300 rounded-r-lg focus:outline-none focus:ring-2 focus:ring-green-800 transition"
                />
              </div>
            </div>
          </div>
          <div class="mb-6">
            <label for="message" class="block text-gray-700 font-medium mb-1">Your Message <span class="text-orange-500">*</span></label>
            <textarea
              id="message"
              name="message"
              rows="3"
              placeholder="Your Message"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-800 transition"
            ></textarea>
          </div>
          <div class="text-center">
            <button
              type="submit"
              class="bg-green-800 cursor-pointer text-white px-6 py-3 rounded-lg font-medium hover:bg-orange-600 transition duration-200 shadow-md hover:shadow-lg text-lg"
            >
              Submit
            </button>
          </div>
        </form>
        <div id="form-message" class="text-sm mt-4 text-center"></div>
      </div>


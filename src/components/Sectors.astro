---

<section id="sectors" class="py-10 bg-[#F2F5F4] sm:py-20 font-[Poppins,sans-serif]">
  <div class="px-8 mx-auto sm:px-10 lg:px-16 max-w-7xl">
    
    <div class="text-center">
      <h2 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
        Sectors We Serve
      </h2>
      <div class="w-24 h-1 mt-4 mx-auto bg-yellow-500 rounded"></div>
      <p class="mt-6 max-w-4xl mx-auto text-lg text-gray-600">
        Our multidisciplinary expertise empowers growth across India's most vital sectors, driving innovation and contributing to a self-reliant nation.
      </p>
    </div>

    <div class="w-full mx-auto mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      
      {sectors.map(sector => (
        <div class="rounded-xl shadow-lg p-8 text-center border-t-4 border-yellow-500 bg-gray-50 transition-all duration-300 hover:shadow-2xl hover:-translate-y-2 flex flex-col">
          <div class="flex justify-center mb-5" set:html={sector.icon} />
          <h3 class="text-xl font-bold text-gray-900">{sector.title}</h3>
          <p class="mt-2 text-gray-600 text-center flex-grow" set:html={sector.description} />
        </div>
      ))}
      
    </div>
  </div>
</section>
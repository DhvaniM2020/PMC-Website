---
// src/components/Sectors.astro

const sectors = [
  {
    title: "Agro & Food Processing",
    description: "Executed over 80+ cluster-based projects valued at ₹4595+ Crores under PMKSY, including 13 Mega Food Parks, 10 Cold Chain Projects, and 8 Agro Processing Clusters.",
    icon: "/process.png"
  },
  {
    title: "Textile",
    description: "Facilitating modernization and growth through national textile policies and the development of mega integrated textile parks (MITRA).",
    icon: "/industry.png"
  },
  {
    title: "Electronics",
    description: "Supporting the national mission on electronics manufacturing to build a self-reliant and competitive tech ecosystem in India.",
    icon: "/iot.png"
  },
  {
    title: "Space",
    description: "Pioneering private sector involvement in the space industry, from component manufacturing to satellite launch services.",
    icon: "/satellite.png"
  },
  {
    title: "MSME",
    description: "Empowering Micro, Small, and Medium Enterprises through strategic cluster development and access to government support schemes.",
    icon: "/msme.png"
  },
  {
    title: "Commerce",
    description: "Enhancing national and international trade by developing robust commercial infrastructure and multi-modal logistics parks.",
    icon: "/commerce.png"
  }
];
---

<section id="sectors" class="py-10 bg-white sm:py-20 font-[Poppins,sans-serif] scroll-mt-30">
  <div class="px-8 mx-auto sm:px-10 lg:px-16 max-w-7xl">
    
    <div class="text-center">
      <h2 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
        Sectors We Serve
      </h2>
      <div class="w-24 h-1 mt-4 mx-auto bg-green-700 rounded"></div>
      <p class="mt-6 max-w-4xl mx-auto text-lg text-gray-600">
        Our multidisciplinary expertise empowers growth across India's most vital sectors, driving innovation and contributing to a self-reliant nation.
      </p>
    </div>

    <div class="w-full mx-auto mt-16">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
        
        {sectors.map((sector, index) => (
          <div class="relative">
            <!-- Content -->
            <div class="p-6 text-center flex flex-col items-center">
              <img 
                src={sector.icon} 
                alt={sector.title} 
                class="w-16 h-16 mx-auto mb-5 object-contain" 
                loading="lazy"
              />
              <h3 class="text-xl font-bold text-gray-900">{sector.title}</h3>
              <p class="mt-2 text-gray-600 text-center" set:html={sector.description} />
            </div>
            
            <!-- Mobile dividers (5 horizontal lines between 6 items) -->
            {index < sectors.length - 1 && (
              <div class="block sm:hidden border-t border-orange-200 mx-6"></div>
            )}
            
            <!-- Tablet dividers -->
            <!-- Vertical lines for tablet (after first and third items) -->
            {(index === 0 || index === 2 || index === 4) && (
              <div class="hidden sm:block lg:hidden absolute top-0 bottom-0 right-0 w-px bg-orange-200"></div>
            )}
            <!-- Horizontal lines for tablet (after first 4 items) -->
            {index < 4 && (
              <div class="hidden sm:block lg:hidden border-t border-orange-200 mx-6"></div>
            )}
            
            <!-- Desktop dividers -->
            <!-- Vertical lines for desktop (after first and second column items) -->
            {(index === 0 || index === 1 || index === 3 || index === 4) && (
              <div class="hidden lg:block absolute top-0 bottom-0 right-0 w-px bg-orange-200"></div>
            )}
            <!-- Horizontal lines for desktop (after first row - index 0,1,2) -->
            {index < 3 && (
              <div class="hidden lg:block absolute bottom-0 left-6 right-6 h-px bg-orange-200"></div>
            )}
          </div>
        ))}
        
      </div>
    </div>
  </div>
</section>
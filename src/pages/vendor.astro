---
import Layout from "../layout/Layout.astro";
---

<Layout title="Vendor Registration">
    <main class="w-full">
        <div class="hero-section relative w-full mb-10">
            <img
                src="/Vendor form header.jpg"
                alt="Vendor registration banner"
                class="w-full h-70 object-cover" />
        </div>

        <div class="container mx-auto px-3 md:px-12 py-12 flex flex-col items-center">
            <div class="text-center w-full max-w-4xl">
                <h2 class="text-5xl md:text-6xl font-extrabold mb-8 text-gray-900">
                    Vendor Registration
                </h2>
                <div class="w-24 h-1 mt-4 mx-auto bg-yellow-500 rounded-full mb-10"></div>
                <p class="mb-12 text-gray-700 text-lg leading-relaxed">
                    Welcome to the Abhyuday Bharat Projects Pvt. Ltd. Vendor Registration. We are looking for reliable and experienced partners to join us in our mission. Please fill out this form to register your company and become a valued contractor or supplier for our Agro & Food projects.
                </p>
            </div>

            <form
                method="post"
                class="w-full max-w-5xl grid grid-cols-1 md:grid-cols-2 gap-8 bg-gray-50 p-8 md:p-12 rounded-2xl shadow-xl border border-gray-200 transition-all duration-300 hover:shadow-2xl hover:bg-white"
            >
                <div class="form-field">
                    <label class="block text-sm font-semibold mb-2 text-gray-800"
                        >Company Name <span class="text-red-500">*</span></label
                    >
                    <input
                        type="text"
                        placeholder="Company Name"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
                        required
                    />
                </div>

                <div class="form-field">
                    <label class="block text-sm font-semibold mb-2 text-gray-800"
                        >GST Number <span class="text-red-500">*</span></label
                    >
                    <input
                        type="text"
                        placeholder="GST Number"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
                        required
                    />
                </div>

                <div class="form-field md:col-span-2">
                    <label class="block text-sm font-semibold mb-2 text-gray-800"
                        >Company Address <span class="text-red-500">*</span></label
                    >
                    <input
                        type="text"
                        placeholder="Full Address with State, City and Zipcode"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
                        required
                    />
                </div>

                <div class="form-field">
                    <label class="block text-sm font-semibold mb-2 text-gray-800"
                        >Key Person Name <span class="text-red-500">*</span></label
                    >
                    <input
                        type="text"
                        placeholder="Key Person Name"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
                        required
                    />
                </div>

                <div class="form-field">
                    <label class="block text-sm font-semibold mb-2 text-gray-800">Contact No <span class="text-red-500">*</span></label>
                    <div id="phone-container" class="flex">
                        <input type="tel" id="contactNo" name="contactNo" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300" required />
                    </div>
                </div>

                <div class="form-field">
                    <label class="block text-sm font-semibold mb-2 text-gray-800">Email <span class="text-red-500">*</span></label>
                    <input
                        type="email"
                        placeholder="Email Address"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
                    />
                </div>

                <div class="form-field">
                    <label class="block text-sm font-semibold mb-2 text-gray-800">Website</label>
                    <input
                        type="url"
                        placeholder="https://yourdomain.com"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
                    />
                </div>

                <div class="form-field">
                    <label class="block text-sm font-semibold mb-2 text-gray-800"
                        >Year of Establishment</label
                    >
                    <select
                        id="yearOfEstablishment"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
                    >
                        <option value="">Select Year</option>
                    </select>
                </div>

                <div class="form-field">
                    <label class="block text-sm font-semibold mb-2 text-gray-800"
                        >Register As</label
                    >
                    <select
                        class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
                    >
                        <option>Select</option>
                        <option>Civil Contractor</option>
                        <option>PNM Supplier</option>
                        <option>Labor Contractor</option>
                        <option>Others</option>
                    </select>
                </div>

                <div class="form-field">
                    <label class="block text-sm font-semibold mb-2 text-gray-800"
                        >Last Year Turnover (Amount in ₹)<span class="text-red-500">*</span></label
                    >
                    <input
                        type="text"
                        placeholder="Enter turnover amount (e.g. 50 Lakh)"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
                        required
                    />
                </div>

                <div class="form-field">
                    <label class="block text-sm font-semibold mb-2 text-gray-800"
                        >Turnover Range <span class="text-red-500">*</span></label
                    >
                    <select
                        class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
                    >
                        <option>-- Select Turnover Range --</option>
                        <option>0 - 1 Crore</option>
                        <option>1 - 5 Crore</option>
                        <option>5 - 10 Crore</option>
                        <option>Above 10 Crore</option>
                    </select>
                </div>
                
                <div class="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-semibold mb-2 text-gray-800"
                            >Company’s Project/Work Portfolio <span class="text-red-500">*</span></label
                        >
                        <input
                            type="file"
                            multiple
                            class="w-full p-3 border border-gray-300 rounded-lg bg-white file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 transition-all duration-300"
                            required
                        />
                        <p class="text-xs text-gray-500 mt-2">
                            (Only .jpg, .jpeg, .png, .pdf files are allowed. Use Ctrl/Cmd key to select multiple files. File size should be less than 10MB)
                        </p>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold mb-2 text-gray-800"
                            >Udyam Certificate</label
                        >
                        <input
                            type="file"
                            multiple
                            class="w-full p-3 border border-gray-300 rounded-lg bg-white file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 transition-all duration-300"
                        />
                        <p class="text-xs text-gray-500 mt-2">
                            (Pdf files are allowed. Use Ctrl/Cmd key to select multiple files. File size should be less than 10MB)
                        </p>
                    </div>
                </div>

                <div class="md:col-span-2 text-center mt-6">
                    <button
                        type="submit"
                        class="bg-green-800 text-white px-6 py-3 rounded-lg font-medium hover:bg-orange-600 transition duration-200 shadow-md hover:shadow-lg text-lg"
                    >
                        Submit
                    </button>
                </div>
            </form>
        </div>
    </main>
</Layout>

<script>
    import 'intl-tel-input/build/css/intlTelInput.css';
    import intlTelInput from 'intl-tel-input';
    
    // Initialize the phone number input
    const input = document.querySelector("#contactNo") as HTMLInputElement | null;
    if (input) {
        intlTelInput(input, {
            initialCountry: "in",
            separateDialCode: true
        });
    }

    // Populate the year dropdown
    const yearSelect = document.getElementById("yearOfEstablishment") as HTMLSelectElement | null;
    if (yearSelect) {
        const currentYear = new Date().getFullYear();
        const startYear = 1900;

        for (let year = currentYear; year >= startYear; year--) {
            const option = document.createElement("option");
            option.value = year.toString();
            option.textContent = year.toString();
            yearSelect.appendChild(option);
        }
    }
</script>
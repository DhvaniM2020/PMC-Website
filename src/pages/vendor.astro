---
import Layout from "../layout/Layout.astro";
---

<Layout title="Vendor Registration">
  <main class="w-full">
    <!-- 🟩 Hero Section -->
    <section class="relative w-full mb-8">
      <img
        src="/Vendor form header.jpg"
        alt="Vendor registration banner"
        class="w-full h-70 object-cover brightness-60"
      />
      <div
        class="absolute inset-0 flex items-center justify-center text-center mt-10"
      >
        <h1
          class="text-5xl md:text-6xl font-extrabold text-white drop-shadow-lg"
        >
          Vendor Registration
        </h1>
      </div>
    </section>

    <!-- 📝 Description (below banner, like Projects page intro) -->
    <section class="container mx-auto px-3 md:px-12 mb-12 text-center">
      <p class="text-gray-700 text-lg leading-relaxed max-w-4xl mx-auto">
        Welcome to the Abhyuday Bharat Projects Pvt. Ltd. Vendor Registration.
        We are looking for reliable and experienced partners to join us in our
        mission. Please fill out this form to register your company and become a
        valued contractor or supplier for our Agro & Food projects.
      </p>
      <div class="w-24 h-1 mt-6 mx-auto bg-green-700 rounded-full"></div>
    </section>

    <!-- 🧾 Vendor Registration Form -->
    <section
      class="container mx-auto px-3 md:px-12 pb-20 flex flex-col items-center"
    >
      <form
        method="post"
        class="w-full max-w-5xl grid grid-cols-1 md:grid-cols-2 gap-8 bg-gray-50 p-8 md:p-12 rounded-2xl shadow-xl border border-gray-200 transition-all duration-300 hover:shadow-2xl hover:bg-white"
      >
        <div class="form-field">
          <label class="block text-sm font-semibold mb-2 text-gray-800"
            >Company Name <span class="text-red-500">*</span></label
          >
          <input
            type="text"
            placeholder="Company Name"
            class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
            required
          />
        </div>

        <div class="form-field">
          <label class="block text-sm font-semibold mb-2 text-gray-800"
            >GST Number <span class="text-red-500">*</span></label
          >
          <input
            type="text"
            placeholder="GST Number"
            class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
            required
          />
        </div>

        <div class="form-field md:col-span-2">
          <label class="block text-sm font-semibold mb-2 text-gray-800"
            >Company Address <span class="text-red-500">*</span></label
          >
          <input
            type="text"
            placeholder="Full Address with State, City and Zipcode"
            class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
            required
          />
        </div>

        <div class="form-field">
          <label class="block text-sm font-semibold mb-2 text-gray-800"
            >Key Person Name <span class="text-red-500">*</span></label
          >
          <input
            type="text"
            placeholder="Key Person Name"
            class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
            required
          />
        </div>

        <div class="form-field">
          <label class="block text-sm font-semibold mb-2 text-gray-800"
            >Contact No <span class="text-red-500">*</span></label
          >
          <div id="phone-container" class="flex">
            <input
              type="tel"
              id="contactNo"
              name="contactNo"
              class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
              required
            />
          </div>
        </div>

        <div class="form-field">
          <label class="block text-sm font-semibold mb-2 text-gray-800"
            >Email <span class="text-red-500">*</span></label
          >
          <input
            type="email"
            placeholder="Email Address"
            class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
          />
        </div>

        <div class="form-field">
          <label class="block text-sm font-semibold mb-2 text-gray-800"
            >Website</label
          >
          <input
            type="url"
            placeholder="https://yourdomain.com"
            class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
          />
        </div>

        <div class="form-field">
          <label class="block text-sm font-semibold mb-2 text-gray-800"
            >Year of Establishment</label
          >
          <select
            id="yearOfEstablishment"
            class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
          >
            <option value="">Select Year</option>
          </select>
        </div>

        <div class="form-field">
          <label class="block text-sm font-semibold mb-2 text-gray-800"
            >Register As</label
          >
          <select
            class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
          >
            <option>Select</option>
            <option>Civil Contractor</option>
            <option>PNM Supplier</option>
            <option>Labor Contractor</option>
            <option>Others</option>
          </select>
        </div>

        <div class="form-field">
          <label class="block text-sm font-semibold mb-2 text-gray-800"
            >Last Year Turnover (Amount in ₹)<span class="text-red-500">*</span
            ></label
          >
          <input
            type="text"
            placeholder="Enter turnover amount (e.g. 50 Lakh)"
            class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
            required
          />
        </div>

        <div class="form-field">
          <label class="block text-sm font-semibold mb-2 text-gray-800"
            >Turnover Range <span class="text-red-500">*</span></label
          >
          <select
            class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-300 focus:border-transparent transition-all duration-300"
          >
            <option>-- Select Turnover Range --</option>
            <option>0 - 1 Crore</option>
            <option>1 - 5 Crore</option>
            <option>5 - 10 Crore</option>
            <option>Above 10 Crore</option>
          </select>
        </div>

        <div class="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-semibold mb-2 text-gray-800"
              >Company's Project/Work Portfolio <span class="text-red-500"
                >*</span
              ></label
            >
            <input
              type="file"
              multiple
              class="w-full p-3 border border-gray-300 rounded-lg bg-white file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 transition-all duration-300"
              required
            />
            <p class="text-xs text-gray-500 mt-2">
              (Only .jpg, .jpeg, .png, .pdf files are allowed. Use Ctrl/Cmd key
              to select multiple files. File size should be less than 10MB)
            </p>
          </div>

          <div>
            <label class="block text-sm font-semibold mb-2 text-gray-800"
              >Udyam Certificate</label
            >
            <input
              type="file"
              multiple
              class="w-full p-3 border border-gray-300 rounded-lg bg-white file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 transition-all duration-300"
            />
            <p class="text-xs text-gray-500 mt-2">
              (Pdf files are allowed. Use Ctrl/Cmd key to select multiple files.
              File size should be less than 10MB)
            </p>
          </div>
        </div>

        <div class="md:col-span-2 flex justify-center mt-6">
    <button class="animated-button">

  <svg viewBox="0 0 24 24" class="arr-2" xmlns="http://www.w3.org/2000/svg">
    <path
      d="M16.1716 10.9999L10.8076 5.63589L12.2218 4.22168L20 11.9999L12.2218 19.778L10.8076 18.3638L16.1716 12.9999H4V10.9999H16.1716Z"
    ></path>
  </svg>
  <span class="text">SEND</span>
  <span class="circle"></span>
  <svg viewBox="0 0 24 24" class="arr-1" xmlns="http://www.w3.org/2000/svg">
    <path
      d="M16.1716 10.9999L10.8076 5.63589L12.2218 4.22168L20 11.9999L12.2218 19.778L10.8076 18.3638L16.1716 12.9999H4V10.9999H16.1716Z"
    ></path>
  </svg>
</button>
        </div>
      </form>
    </section>
  </main>
</Layout>

<style>
    /* From Uiverse.io by gharsh11032000 */ 
.animated-button {
  position: relative;
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 16px 36px;
  border: 4px solid;
  border-color: transparent;
  font-size: 16px;
  background-color: inherit;
  border-radius: 100px;
  font-weight: 600;
  color: green;
  box-shadow: 0 0 0 2px green;
  cursor: pointer;
  overflow: hidden;
  transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
}

.animated-button svg {
  position: absolute;
  width: 24px;
  fill: green;
  z-index: 9;
  transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
}

.animated-button .arr-1 {
  right: 16px;
}

.animated-button .arr-2 {
  left: -25%;
}

.animated-button .circle {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20px;
  height: 20px;
  background-color: green;
  border-radius: 50%;
  opacity: 0;
  transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
}

.animated-button .text {
  position: relative;
  z-index: 1;
  transform: translateX(-12px);
  transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
}

.animated-button:hover {
  box-shadow: 0 0 0 12px transparent;
  color: #ffffff;
  border-radius: 12px;
}

.animated-button:hover .arr-1 {
  right: -25%;
}

.animated-button:hover .arr-2 {
  left: 16px;
}

.animated-button:hover .text {
  transform: translateX(12px);
}

.animated-button:hover svg {
  fill: #ffffff;
}

.animated-button:active {
  scale: 0.95;
  box-shadow: 0 0 0 4px green;
}

.animated-button:hover .circle {
  width: 220px;
  height: 220px;
  opacity: 1;
}


  @keyframes fly-1 {
    from {
      transform: translateY(0.1em);
    }

    to {
      transform: translateY(-0.1em);
    }
  }
</style>

<!-- Script -->
<script>
  import "intl-tel-input/build/css/intlTelInput.css";
  import intlTelInput from "intl-tel-input";

  // Wait for DOM to be fully loaded
  document.addEventListener("DOMContentLoaded", function () {
    // Type assertion for phone input
    const input = document.querySelector("#contactNo") as HTMLInputElement;
    if (input) {
      intlTelInput(input, {
        initialCountry: "in",
        separateDialCode: true,
      });
    }

    // Year dropdown population
    const yearSelect = document.getElementById(
      "yearOfEstablishment"
    ) as HTMLSelectElement;
    if (yearSelect) {
      const currentYear = new Date().getFullYear();
      for (let year = currentYear; year >= 1900; year--) {
        const option = document.createElement("option");
        option.value = year.toString();
        option.textContent = year.toString();
        yearSelect.appendChild(option);
      }
    }
  });
</script>
